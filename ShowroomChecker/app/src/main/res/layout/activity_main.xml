<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_idle"
    android:layoutDirection="rtl">

    <!-- 1. Top Compact Showroom Selector Bar -->
    <LinearLayout
        android:id="@+id/showroomTopBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="@color/primary"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_store"
            app:tint="@color/white"
            android:contentDescription="Store" />

        <LinearLayout
            android:id="@+id/btnChangeShowroomArea"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المعرض المفحوص:"
                android:textColor="#B3FFFFFF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/txtCurrentShowroom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_showroom_selected"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <Button
            android:id="@+id/btnChangeShowroom"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/change_showroom"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#26FFFFFF"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            app:tint="@color/white"
            android:contentDescription="Settings"
            android:padding="6dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- 2. Barcode Input Box (Receives hardware Honeywell scanner wedge input reliably) -->
    <LinearLayout
        android:id="@+id/inputContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="2dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/editBarcodeCatch"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_rounded_card"
            android:gravity="center_vertical|start"
            android:hint="امسح الباركود بالليزر أو اكتبه هنا..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:singleLine="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="15sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnManualLookup"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="فحص"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary"
            android:layout_marginStart="8dp"
            app:cornerRadius="8dp" />

        <ImageButton
            android:id="@+id/btnCameraScan"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_camera"
            app:tint="@color/white"
            android:background="@drawable/bg_rounded_card"
            android:backgroundTint="@color/primary_dark"
            android:contentDescription="كاميرا الجوال"
            android:layout_marginStart="6dp"
            android:padding="10dp" />
    </LinearLayout>

    <!-- 3. FULL SCREEN SCAN RESULT HERO AREA -->
    <FrameLayout
        android:id="@+id/mainScanArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/bg_idle">

        <!-- A. Idle Prompt View -->
        <LinearLayout
            android:id="@+id/layoutPrompt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷"
                android:textSize="64sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_prompt"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="14dp"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/txtPromptSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="امسح بليزر هانيويل أو انقر هنا للمسح بكاميرا الجوال 📷"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:textAlignment="center" />
        </LinearLayout>

        <!-- B. Ultra-Fast Loading Spinner -->
        <LinearLayout
            android:id="@+id/layoutLoading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:indeterminateTint="@color/white" />

            <TextView
                android:id="@+id/txtLoadingLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/searching"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <!-- C. Stock Result View (Names, Barcode, Stock, Availability, Sales & Need Cards) -->
        <ScrollView
            android:id="@+id/layoutResult"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <!-- 1. English Product Name (Top) -->
                <TextView
                    android:id="@+id/txtProductNameEn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Product English Name"
                    android:textColor="#E2E8F0"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textAlignment="center"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <!-- 2. Arabic Product Name (Under English Name) -->
                <TextView
                    android:id="@+id/txtProductNameAr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="اسم الصنف العربي"
                    android:textColor="#FDE047"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />

                <!-- 3. Barcode Number (Under Arabic Name) -->
                <TextView
                    android:id="@+id/txtResultBarcode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6281100180012"
                    android:textColor="#E6FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:background="#26000000"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_marginTop="6dp" />

                <!-- 4. GIGANTIC STOCK QUANTITY NUMBER -->
                <TextView
                    android:id="@+id/txtStockQty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15"
                    android:textColor="@color/white"
                    android:textSize="76sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:layout_marginTop="4dp" />

                <!-- 5. Unit Label -->
                <TextView
                    android:id="@+id/txtUnitLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_piece"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="-6dp" />

                <!-- 6. Status Indicator Pill -->
                <TextView
                    android:id="@+id/txtStockStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stock_available"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="#33000000"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_marginTop="8dp" />

                <!-- 7. Two KPI Cards (Sales in Period & Net Need After Balance Deduction) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:weightSum="2">

                    <!-- Box 1: Sales in Period -->
                    <LinearLayout
                        android:id="@+id/cardSales"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_rounded_card"
                        android:backgroundTint="#26000000"
                        android:padding="10dp"
                        android:gravity="center"
                        android:layout_marginEnd="5dp">

                        <TextView
                            android:id="@+id/txtSalesCardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📈 المبيعات خلال الفترة"
                            android:textColor="#E2E8F0"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/txtSoldQtyVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FDE047"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/txtSoldRateVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="معدل: 0/شهر"
                            android:textColor="#CBD5E1"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Box 2: Net Need After Balance Deduction -->
                    <LinearLayout
                        android:id="@+id/cardNeed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_rounded_card"
                        android:backgroundTint="#26000000"
                        android:padding="10dp"
                        android:gravity="center"
                        android:layout_marginStart="5dp">

                        <TextView
                            android:id="@+id/txtNeedCardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎯 احتياج بعد خصم الرصيد"
                            android:textColor="#E2E8F0"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/txtNetNeedVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/white"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/txtNetNeedBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="المخزون متوازن"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_stock_badge"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:gravity="center"
                            android:layout_marginTop="3dp" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- D. Not Found / Unrecognized View -->
        <LinearLayout
            android:id="@+id/layoutNotFound"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️"
                android:textSize="72sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/product_not_found"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/txtNotFoundBarcode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6281100180012"
                android:textColor="#E6FFFFFF"
                android:textSize="18sp"
                android:fontFamily="monospace"
                android:background="#33000000"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الصنف غير مسجل في قاعدة بيانات أودو"
                android:textColor="#E6FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="12dp"
                android:textAlignment="center" />
        </LinearLayout>

    </FrameLayout>

    <!-- 4. Minimal Bottom Status Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:background="#0F172A"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtScanCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الأصناف: 0"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="تصميم/ عبدالله الخطيب"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="امسح التالي للمتابعة ⚡"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
