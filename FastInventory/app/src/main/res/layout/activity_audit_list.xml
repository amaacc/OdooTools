<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/auditTopBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/txtAuditTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="📋 قائمة الأصناف المحصورة"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClearSession"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minHeight="0dp"
            android:text="🗑️ مسح الكل"
            android:textColor="@color/text_danger"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Search / Filter Input -->
    <EditText
        android:id="@+id/etSearchAudit"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_count_box"
        android:hint="🔍 بحث بالاسم العربي، الإنجليزي، الكود، أو الباركود..."
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/auditTopBar" />

    <!-- RecyclerView of Scanned Items -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAuditItems"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:padding="10dp"
        app:layout_constraintBottom_toTopOf="@+id/auditBottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etSearchAudit" />

    <!-- Empty State View -->
    <TextView
        android:id="@+id/txtEmptyAudit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="لا توجد أصناف في جلسة الجرد الحالية.\nابدأ بمسح الباركود لإضافتها."
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/auditBottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etSearchAudit" />

    <!-- Bottom Actions & Stats Bar -->
    <LinearLayout
        android:id="@+id/auditBottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_card_secondary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtAuditStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الأصناف: 0 | الحبات: 0"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtAuditZoneTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المنطقة: الرف العام"
                android:textColor="@color/text_cyan"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnExportFromAudit"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="@color/primary"
            android:text="📊 تصدير وإرسال"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
